generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String      @id @default(cuid())
  name               String
  email              String      @unique
  passwordHash       String
  role               String      @default("staff") // "manager" | "staff"
  resetOtp           String?
  resetOtpExpiresAt  DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  documents          Document[]
  stockMoves         StockMove[]
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now())

  products    Product[]
}

model Warehouse {
  id          String     @id @default(cuid())
  name        String
  code        String     @unique
  address     String?
  managerName String?
  status      String     @default("active") // "active" | "inactive"
  createdAt   DateTime   @default(now())

  locations   Location[]
  documents   Document[]
}

model Location {
  id            String          @id @default(cuid())
  warehouseId   String?
  warehouse     Warehouse?      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  name          String
  code          String          @unique
  isVirtual     Boolean         @default(false)
  type          String          @default("internal") // "internal" | "supplier" | "customer" | "adjustment"
  createdAt     DateTime        @default(now())

  stockQuantities StockQuantity[]
  fromMoves       StockMove[]     @relation("FromLocationMoves")
  toMoves         StockMove[]     @relation("ToLocationMoves")
  fromItems       DocumentItem[]  @relation("ItemFromLocation")
  toItems         DocumentItem[]  @relation("ItemToLocation")
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  createdAt     DateTime   @default(now())

  documents     Document[]
}

model Product {
  id              String          @id @default(cuid())
  name            String
  sku             String          @unique
  categoryId      String
  category        Category        @relation(fields: [categoryId], references: [id])
  uom             String          @default("units") // kg, units, pcs, meters, etc.
  reorderMin      Float           @default(10)
  reorderMax      Float           @default(100)
  description     String?
  status          String          @default("active") // "active" | "archived"
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  stockQuantities StockQuantity[]
  documentItems   DocumentItem[]
  stockMoves      StockMove[]
}

model StockQuantity {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
}

model Document {
  id             String         @id @default(cuid())
  documentNumber String         @unique
  type           String         // "receipt" | "delivery" | "internal" | "adjustment"
  partnerName    String?
  supplierId     String?
  supplier       Supplier?      @relation(fields: [supplierId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?     @relation(fields: [warehouseId], references: [id])
  status         String         @default("draft") // "draft" | "waiting" | "ready" | "done" | "cancelled"
  notes          String?
  createdById    String
  createdBy      User           @relation(fields: [createdById], references: [id])
  validatedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  items          DocumentItem[]
  stockMoves     StockMove[]
}

model DocumentItem {
  id              String    @id @default(cuid())
  documentId      String
  document        Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Float
  countedQuantity Float?
  difference      Float?
  fromLocationId  String?
  fromLocation    Location? @relation("ItemFromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String?
  toLocation      Location? @relation("ItemToLocation", fields: [toLocationId], references: [id])
  notes           String?
}

model StockMove {
  id              String    @id @default(cuid())
  documentId      String?
  document        Document? @relation(fields: [documentId], references: [id])
  productId       String
  product         Product   @relation(fields: [productId], references: [id])
  fromLocationId  String
  fromLocation    Location  @relation("FromLocationMoves", fields: [fromLocationId], references: [id])
  toLocationId    String
  toLocation      Location  @relation("ToLocationMoves", fields: [toLocationId], references: [id])
  quantity        Float
  balanceAfter    Float?
  transactionType String    // "receipt" | "delivery" | "internal" | "adjustment"
  referenceNumber String
  userId          String?
  user            User?     @relation(fields: [userId], references: [id])
  reason          String?
  createdAt       DateTime  @default(now())
}
